# SmartGuard AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=SmartGuard AI
APP_ENV=development
API_PREFIX=/api
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Where to find this in Supabase:
#   Project Settings → Database → Connection string → URI
#   Select "Session mode" (port 5432) for direct connections.
#   Select "Transaction mode" (port 6543) when behind a pooler.
#
# Example (replace with your real values):
#   DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Never share or commit this value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── IoT Microservice Bridge ──────────────────────────────────────────────────
# Backend and IoT service must be configured independently with the same secret.
# Generate a new random value and set it separately in each service's .env.
IOT_MICROSERVICE_URL=http://localhost:8001
IOT_SERVICE_SECRET=
IOT_AUTO_CLOSE_DURATION_MS=15000
