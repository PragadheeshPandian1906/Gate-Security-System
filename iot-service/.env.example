# SmartGuard AI — IoT Microservice Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ── Microservice ──────────────────────────────────────────────────────────────
IOT_SERVICE_HOST=0.0.0.0
IOT_SERVICE_PORT=8001
IOT_LOG_LEVEL=INFO

# ── ESP32 Device Credentials ──────────────────────────────────────────────────
# Must match the ESP32 firmware constants DEVICE_ID and DEVICE_KEY
IOT_DEVICE_ID=smartguard-esp32-01
IOT_DEVICE_KEY=

# ── Service-to-Service Authentication ────────────────────────────────────────
# Secret used by the main backend to publish gate decisions to this service.
# Must also be set in the main backend's .env as IOT_SERVICE_SECRET.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IOT_SERVICE_SECRET=

# ── Main Backend (for CORS origin allowance) ──────────────────────────────────
# Comma-separated list of trusted origins (backend + frontend)
IOT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Timing Thresholds ─────────────────────────────────────────────────────────
IOT_HEARTBEAT_TIMEOUT_SECONDS=30.0
IOT_ACK_TIMEOUT_SECONDS=5.0
IOT_AUTO_CLOSE_DURATION_MS=15000

# ── Hardware Defaults (informational — actual values are in firmware) ─────────
# These are tracked for reference only; the ESP32 controls servo angles.
IOT_SERVO_CLOSED_ANGLE=0
IOT_SERVO_OPEN_ANGLE=90
